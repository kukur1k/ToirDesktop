<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:ToirDesktop.ViewModels"
             x:Class="ToirDesktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
 
    
            <Grid RowDefinitions="*,Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="ТОиР" Grid.Row="0"></TextBlock>
              <Grid RowDefinitions="50,50,50" Grid.Row="1">
                <TextBox Grid.Row="0" Watermark="login" Text="{Binding Email}"></TextBox>
                <TextBox Grid.Row="1" Watermark="Password" Text="{Binding Pass}"></TextBox> 
                <Grid ColumnDefinitions="*,*" Grid.Row="2">
                  <Button Grid.Column="0" Content="Войти" Command="{Binding LoginCommand}"></Button>
                  <Button Grid.Column="1" Content="Восстановить пароль"></Button>
                </Grid>
              </Grid>
              <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="Red" IsVisible="{Binding HasError}"></TextBlock>
            </Grid>


</UserControl>
