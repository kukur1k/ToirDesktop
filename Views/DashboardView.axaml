<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ToirDesktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ToirDesktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

             <ScrollViewer>
                <StackPanel Margin="15">
                  <TextBlock FontSize="16" FontWeight="Bold" Margin="10" Text="Дашборд мастера"></TextBlock>
                    
                    <TextBlock FontSize="14" FontWeight="Bold" Margin="10" Text="Карточки KPI"></TextBlock>

                      <WrapPanel Orientation="Horizontal">
                        <Border BorderBrush="#E4DDDD"
                      BorderThickness="1"
                      Padding="8"
                        CornerRadius="10"
                        Margin="10"
                       Background="White">
                        <StackPanel  HorizontalAlignment="Center">
                          <TextBlock Text="Всего оборудования (активно / в ремонте)" Foreground="#666"></TextBlock>
                          <TextBlock Text="{Binding EqCountStr}"></TextBlock>
                        </StackPanel>
                      </Border>


                         <Border BorderBrush="#E4DDDD"
                      BorderThickness="1"
                        Padding="8"
                        CornerRadius="10"
                        Margin="10"
                       Background="White">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock Text="Активные заявки" Foreground="#666"></TextBlock>
                          <TextBlock Text="{Binding CountActiveOrders, StringFormat='Активные: {0}'}"
                        Foreground="Green"></TextBlock>
                          <TextBlock Text="{Binding CountLostOrders, StringFormat='Просроченные: {0}'}"
                         Foreground="Red"></TextBlock>
                        </StackPanel>
                      </Border>


                         <Border BorderBrush="#E4DDDD"
                      BorderThickness="1"
                        Padding="8"
                        CornerRadius="10"
                        Margin="10"
                       Background="White">
                        <StackPanel  HorizontalAlignment="Center">
                          <TextBlock Text="Заявок на сегодня" Foreground="#666"></TextBlock>
                            <TextBlock Text="{Binding NowPlanOrders, StringFormat='Запланировано: {0}'}"></TextBlock>
                          <TextBlock Text="{Binding NowCreateOrders, StringFormat='Создано сегодня: {0}'}"></TextBlock>
                        </StackPanel>
                      </Border>

                      </WrapPanel>


                    <TextBlock FontSize="14" FontWeight="Bold" Margin="10" Text="Активные заявки"></TextBlock>
                    <StackPanel HorizontalAlignment="Stretch">
                      <DataGrid ItemsSource="{Binding Table}"
                                  GridLinesVisibility="All"
                                  BorderBrush="#666" BorderThickness="1"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True">
                      <DataGrid.Columns>
                          <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                          <DataGridTextColumn Header="Оборудование" Binding="{Binding Eq}" Width="*" />

                          <DataGridTemplateColumn Header="Приоритет" Width="*">
                            <DataTemplate>
                              <StackPanel Background="{Binding ColorCodePriority}">
                                <TextBlock HorizontalAlignment="Center"
                                            Text="{Binding Priority}"></TextBlock>
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn>

                             <DataGridTemplateColumn Header="Статус" Width="*">
                            <DataTemplate>
                              <StackPanel Background="{Binding StatusColor}">
                                <TextBlock  HorizontalAlignment="Center" 
                                            Text="{Binding Status}"></TextBlock>
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn>

                          <DataGridTextColumn Header="Бригада" Binding="{Binding Brigade}" Width="*" />
                          <DataGridTextColumn Header="Дата начала" Binding="{Binding DateStart}" Width="*" />
                          <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>

                    </StackPanel>
                  
              </StackPanel>
             </ScrollViewer>
             
  
</UserControl>
